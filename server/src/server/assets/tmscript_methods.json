    "Force": {
      "description": "Force class for robot force control settings and motions. Used with FTSensor for force/torque-based control.",
      "constructors": [
          {
              "types": ["string"],
              "texts": ["Model"]
          }
      ],
      "attributes": {},
      "methods": {
        "Reset": {
          "documentation": "Reset all the force control motion parameters to the default except the sensor name.",
          "parameters": {
              "types": [""],
              "texts": [""],
              "return": ["void"]
          }
        },
        "Frame": {
          "documentation": "Set the reference base of the force control motion. 0=Robot base, 1=Tool (default), 2=Current base, 3=Trajectory.",
          "parameters": {
              "types": ["int"],
              "texts": ["Base"],
              "return": ["void"]
          }
        },
        "Distance": {
          "documentation": "Set the moving distance of the force control motion in mm. Available only in SetPoint F/T operation mode. <0=No limit, >=0=Limited distance.",
          "parameters": {
              "types": ["int"],
              "texts": ["Distance"],
              "return": ["void"]
          }
        },
        "ProtectionSpeed": {
          "documentation": "Set the speed protection of the force control motion against axial force or torque.",
          "parameters": {
              "types": ["int", "int", "int", "int", "int", "int"],
              "texts": ["X", "Y", "Z", "RX", "RY", "RZ"],
              "return": ["void"]
          }
        },
        "FTSet": {
          "documentation": "Set the force and torque of the force control motion. Positive/negative values denote force control direction. Can adjust PID control parameters.",
          "parameters": {
              "types": ["int", "bool", "float", "int", "int"],
              "texts": ["Axis", "Enable", "Control Value", "PID", "Speed"],
              "return": ["void"]
          }
        },
        "Trajectory": {
          "documentation": "Set the trajectory path of the force control motion. Trajectory F/T operation mode. Use subflow name or customized function.",
          "parameters": {
              "types": ["string"],
              "texts": ["Subflow name"],
              "return": ["void"]
          }
        },
        "Timeout": {
          "documentation": "Set the stop condition of timeout in milliseconds. Available only in SetPoint F/T operation mode. <0=Disable, >=0=Timeout duration. Call with no params to cancel.",
          "parameters": {
              "types": ["int"],
              "texts": ["Timeout"],
              "return": ["void"]
          }
        },
        "AllowPosTol": {
          "documentation": "Set the stop condition of tolerant position error in mm. <0=Disable, >=0=Distance of tolerant error. Call with no params to cancel.",
          "parameters": {
              "types": ["int"],
              "texts": ["Error Distance"],
              "return": ["void"]
          }
        },
        "DInput": {
          "documentation": "Set the stop condition of the digital input. Call with no params to cancel.",
          "parameters": {
              "types": ["string", "int", "int"],
              "texts": ["Module", "Channel", "Condition"],
              "return": ["void"]
          }
        },
        "AInput": {
          "documentation": "Set the stop condition of the analog input. Call with no params to cancel.",
          "parameters": {
              "types": ["string", "int", "int", "float"],
              "texts": ["Module", "Channel", "Condition", "Condition Value"],
              "return": ["void"]
          }
        },
        "FTReached": {
          "documentation": "Set the stop condition of monitoring force/torque values. Call with no params to cancel.",
          "parameters": {
              "types": ["int", "bool", "float"],
              "texts": ["Force Type", "Enable", "Monitoring Value"],
              "return": ["void"]
          }
        },
        "Condition": {
          "documentation": "Set the stop condition of the conditional expression. Call with no params to cancel.",
          "parameters": {
              "types": ["bool"],
              "texts": ["Conditional"],
              "return": ["void"]
          }
        },
        "Start": {
          "documentation": "Start the force control motion. Returns result: 0=Not Working, 1=Working, 2=Timeout, 3=Distance reached, 4=IO triggered, 5=Resisted, 6=Error, 14=Over Speed, 201-206=Various stop conditions.",
          "parameters": {
              "types": ["bool", "bool"],
              "texts": ["Zero Sensor", "Enable gravity"],
              "return": ["int"]
          }
        },
        "Stop": {
          "documentation": "Stop the force control motion. Returns result value after force control motion stops.",
          "parameters": {
              "types": [""],
              "texts": [""],
              "return": ["int"]
          }
        }
      }
    }
